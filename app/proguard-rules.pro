# R8 rules for the app module. Library consumer rules are applied automatically.
#
# kotlinx.serialization: the typed navigation routes in com.tfg.kaifit_pal.** are resolved at
# runtime through the serializers generated by the compiler plugin.

# Keep Companion, INSTANCE and serializer() of @Serializable routes: the serializer lookup reaches them by name.
-keepclassmembers @kotlinx.serialization.Serializable class com.tfg.kaifit_pal.** {
    *** Companion;
    *** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}

# Keep every class declaring serializer() (route companions and objects) so R8 cannot drop or rename it.
-keepclasseswithmembers class com.tfg.kaifit_pal.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Typed navigation decodes the enum arguments of a route (Sex and ActivityLevel in ResultsRoute)
# by loading their class with Class.forName(serialName), where serialName is the original class
# name. Keep both enums unrenamed, or opening Results fails with ClassNotFoundException.
-keep enum com.tfg.kaifit_pal.domain.Sex { *; }
-keep enum com.tfg.kaifit_pal.domain.ActivityLevel { *; }
