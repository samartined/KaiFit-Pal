<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules up to Android 11 (Android 12 and later use data_extraction_rules.xml).
   The only rule leaves out the on-device model of Kai-Q (about 2.6 GB, in the models folder of
   the external files directory): it is far over the backup quota, which would stop the whole
   backup, and it can be downloaded again. Whether the profile and the settings should be backed
   up is still an open decision, so everything else keeps the default behaviour.
-->
<full-backup-content>
    <exclude domain="external" path="models/" />
</full-backup-content>
